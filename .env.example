NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never prefix this key with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Try cedar for an alternative voice. No automatic device-voice fallback.
OPENAI_TTS_VOICE=marin
AI_ENABLED=false
TTS_ENABLED=false
# Original-language speech transcription (auto language detection).
STT_ENABLED=false
OPENAI_STT_MODEL=gpt-transcribe
# Public use requires completed professional review and Supabase auth/quotas.
CONTENT_REVIEWED=false
# Explicit PRIVATE dev preview: only non-production loopback requests.
# Ignored on Vercel and in production. Bind dev server to 127.0.0.1.
LOCAL_AI_PREVIEW=false
# Private LOCAL development-only content workspace. Never a production bypass.
LOCAL_ADMIN_PREVIEW=false
# Optional server-side scientific source search (Tavily). No NEXT_PUBLIC_ prefix.
SCIENTIFIC_SEARCH_ENABLED=false
TAVILY_API_KEY=
